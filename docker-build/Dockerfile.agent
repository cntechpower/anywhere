FROM ubuntu:22.04

COPY bin/* /usr/local/anywhere/bin/
COPY credential/* /usr/local/anywhere/credential/

WORKDIR /usr/local/anywhere/

# Provide these at run time; PASSWORD has no default on purpose.
ENV SERVER_ADDR=127.0.0.1 \
    ZONE_NAME=asia-shanghai \
    USER_NAME=admin \
    TLS_SERVER_NAME=anywhere.local

CMD ["sh", "-c", "./bin/anywhere -i \"$HOSTNAME\" -s \"$SERVER_ADDR\" -u \"$USER_NAME\" -z \"$ZONE_NAME\" --pass \"$PASSWORD\" --tls-server-name \"$TLS_SERVER_NAME\""]
